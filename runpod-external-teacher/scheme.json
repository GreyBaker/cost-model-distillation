{
  "schema": "external-xsum-grid-scheme-v1",
  "status": "implemented",
  "default_student": "restored",
  "student_switch_policy": "explicit approval; new pair and grid root; never automatic or per-cell",
  "runtime": {
    "grid_transformers": "5.20.2",
    "restored_student_reference_transformers": "4.57.6",
    "torch_candidate": "2.8.0",
    "torch_candidate_cuda_wheel": "cu128",
    "torch_compatibility": "resolve and test in isolation; stop on incompatibility, do not upgrade existing experiment",
    "attention_implementation": "eager",
    "tf32": false,
    "allow_remote_code": false,
    "grid_teacher_precision": "bfloat16",
    "grid_student_initialization_precision": "float32",
    "distillation_compute_precision": "bfloat16",
    "reference_probe_precision": "float32",
    "final_environment_lock_required": true
  },
  "storage": {
    "one_disposable_disk": true,
    "assume_lifecycle_persistence": false,
    "suggested_free_gib": 200,
    "space_policy": "estimate actual artifacts plus peak temporary copies and environment caches before downloading; 200 GiB is planning headroom, not a fit guarantee",
    "immutable_source": "results_and_temp/",
    "restored_student_source": "results_and_temp/sft-work/student/",
    "pod_copy": "<POD_DISK>/restored-sft/student/",
    "pair_root": "<POD_DISK>/external-xsum-work/pair/",
    "grid_root": "<POD_DISK>/external-xsum-grid/",
    "native_venv": "<POD_DISK>/cost-model-distillation/runpod-external-teacher/.venv-native",
    "legacy_reference_venv": "<POD_DISK>/cost-model-distillation/runpod-external-teacher/.venv-reference"
  },
  "compatibility": {
    "source_hashes_required": true,
    "source_weights_must_not_be_overwritten": true,
    "token_id_mapping_must_match": true,
    "special_token_ids_must_match": true,
    "output_vocabulary_size_must_match": true,
    "normalization_and_tokenization_audit_required": true,
    "tokenizer_adversarial_probes": true,
    "tokenizer_validation_pool_audit": "all validation sources and references",
    "tokenizer_training_sample_size": 2048,
    "preserve_restored_student_parameter_aliases": true,
    "preserve_restored_student_gradient_parameterization": true,
    "restored_student_cross_version_probes_required": true,
    "teacher_native_reload_probes_required": true,
    "same_precision_reload_generation_must_match": true,
    "cross_precision_generation_must_match": false,
    "bf16_probability_drift_report_required": true,
    "fp32_logits_rtol_proposed": 0.0001,
    "fp32_logits_atol_proposed": 0.0001,
    "numeric_tolerance_policy": "initial proposed gates; fail and review discrepancies, never silently relax tolerances",
    "grid_smoke_update_and_resume_required": false,
    "development_smoke_command": "external_teacher.py dev-smoke"
  },
  "validation": {
    "split": "validation",
    "count": 11332,
    "generation": "greedy",
    "num_beams": 1,
    "max_source_tokens": 1024,
    "max_new_tokens": 64,
    "prefix": "summarize: ",
    "reference_truncation": false,
    "rouge": "rouge_score stemmed per-document macro F1 x100",
    "teacher_and_student_same_ids_and_references": true,
    "write_predictions_and_per_example_scores": true,
    "report_empty_and_generation_cap_rates": true,
    "report_paired_bootstrap_difference": true,
    "quality_gate_status": "informational_only_no_quality_admission_gates",
    "operator_approval_before_binding": true,
    "quality_failure_override": "not required; legacy command flags are no-ops and published records remain archival provenance",
    "publisher_scores_are_independently_verified": false,
    "test_split_used_for_decisions": false,
    "periodic_greedy_monitor": false
  },
  "grid": {
    "engine": "../runpod-gkd/distill_grid.py",
    "external_pair_adapter": "implemented in external_workflow/pair.py and gridlib/inputs.py",
    "training_design": "continuous-point-milestones-v2",
    "final_points": 160000,
    "default_end_points": 160000,
    "evaluation_points": [10000, 20000, 40000, 80000, 160000],
    "lr_horizon": "nominal_trajectory_points",
    "lr_warmup_points": 8000,
    "lr_cooldown_begin_points": 120000,
    "lr_cooldown_end_points": 160000,
    "recovery_every_points": 5000,
    "on_policy_percentages": [0, 25, 50, 75, 100],
    "effective_batch": 32,
    "training_generation": "categorical",
    "training_temperature": 1.0,
    "top_k": 0,
    "top_p": 1.0,
    "loss": "forward_kl_teacher_to_student",
    "loss_temperature": 1.0,
    "loss_normalization": "token_mean_per_sequence_then_mean_examples",
    "offline_targets": "human XSum references",
    "off_policy_point_cost": 1,
    "on_policy_point_cost": 2,
    "mixture": "exact_fraction_each_update",
    "budget_policy": "never_exceed",
    "dropout": 0.0,
    "common_initialization": "same immutable FP32 selected SFT student for each of five independent mixtures; milestones continue the same optimizer/RNG trajectory",
    "cell_restart": "full optimizer/RNG/cursor checkpoint; existing typed-CUDA-OOM smaller-microbatch recovery",
    "training_fit_pilot": "existing joint student/teacher hardware pilot; no SFT pilot",
    "evaluation_batch_pilot": "once-only student-only fit and warmed-throughput calibration with tested safety ceiling; historical pilots reused unchanged",
    "baseline": "existing full common baseline in the new runtime",
    "estimate_approval_required": true,
    "reuse_old_grid_binding_or_pilots": false,
    "source_code_fingerprints": "record and warn only; never block resume or force recalibration"
  },
  "accounting": {
    "local_sft_updates": 0,
    "external_training_cost": "publisher-reported history; excluded from our measured compute and point budgets",
    "validation_and_grid_pilots": "report wall/GPU time separately; disposable probes do not enter cell budgets",
    "download_import_export_seconds": "record separately",
    "do_not_fabricate_external_optimizer_or_rng": true
  }
}
